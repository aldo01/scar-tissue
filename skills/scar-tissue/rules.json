{
  "version": 1,
  "rules": [
    { "id": "timeouts.missing", "title": "Outbound call has no timeout", "typical_severity": "high", "file": "TIMEOUTS-AND-RETRIES.md" },
    { "id": "timeouts.budget-mismatch", "title": "Inner timeout longer than the caller's deadline", "typical_severity": "medium", "file": "TIMEOUTS-AND-RETRIES.md" },
    { "id": "retries.no-backoff", "title": "Retries without exponential backoff and jitter", "typical_severity": "high", "file": "TIMEOUTS-AND-RETRIES.md" },
    { "id": "retries.unbounded", "title": "Retries with no attempt or time limit", "typical_severity": "high", "file": "TIMEOUTS-AND-RETRIES.md" },
    { "id": "retries.non-idempotent", "title": "Retrying an operation with side effects", "typical_severity": "critical", "file": "TIMEOUTS-AND-RETRIES.md" },
    { "id": "retries.amplification", "title": "Retries stacked at multiple layers", "typical_severity": "medium", "file": "TIMEOUTS-AND-RETRIES.md" },
    { "id": "retries.permanent-errors", "title": "Retrying errors that will never succeed", "typical_severity": "low", "file": "TIMEOUTS-AND-RETRIES.md" },

    { "id": "idempotency.missing-key", "title": "Side-effecting operation cannot detect repeats", "typical_severity": "critical", "file": "IDEMPOTENCY.md" },
    { "id": "idempotency.check-then-insert", "title": "Deduplication by query-then-insert instead of a unique constraint", "typical_severity": "high", "file": "IDEMPOTENCY.md" },
    { "id": "idempotency.key-stored-after-effect", "title": "Idempotency key recorded after the side effect", "typical_severity": "high", "file": "IDEMPOTENCY.md" },
    { "id": "idempotency.consumer-not-idempotent", "title": "Message or webhook handler not safe to run twice", "typical_severity": "high", "file": "IDEMPOTENCY.md" },
    { "id": "idempotency.unstable-key", "title": "Idempotency key changes between attempts", "typical_severity": "high", "file": "IDEMPOTENCY.md" },

    { "id": "concurrency.lost-update", "title": "Read-modify-write without a lock or condition", "typical_severity": "critical", "file": "CONCURRENCY.md" },
    { "id": "concurrency.check-then-act", "title": "Application-level check before a dependent action", "typical_severity": "high", "file": "CONCURRENCY.md" },
    { "id": "concurrency.lock-without-fencing", "title": "Distributed lock can expire while work continues", "typical_severity": "high", "file": "CONCURRENCY.md" },
    { "id": "concurrency.unbounded-parallelism", "title": "One task per item with no concurrency limit", "typical_severity": "high", "file": "CONCURRENCY.md" },
    { "id": "concurrency.shared-mutable-state", "title": "Request handlers mutate shared state", "typical_severity": "high", "file": "CONCURRENCY.md" },
    { "id": "concurrency.duplicate-scheduled-job", "title": "Scheduled job runs on every replica or overlaps itself", "typical_severity": "high", "file": "CONCURRENCY.md" },

    { "id": "database.n-plus-one", "title": "Query executed once per row in a loop", "typical_severity": "medium", "file": "DATABASE.md" },
    { "id": "database.unbounded-query", "title": "Query or list endpoint without a limit", "typical_severity": "high", "file": "DATABASE.md" },
    { "id": "database.deep-offset-pagination", "title": "OFFSET pagination over large tables", "typical_severity": "medium", "file": "DATABASE.md" },
    { "id": "database.missing-index", "title": "Query filters or sorts on unindexed columns", "typical_severity": "medium", "file": "DATABASE.md" },
    { "id": "database.network-call-in-transaction", "title": "External call made inside a database transaction", "typical_severity": "high", "file": "DATABASE.md" },
    { "id": "database.long-transaction", "title": "Transaction spans a large batch or long work", "typical_severity": "medium", "file": "DATABASE.md" },
    { "id": "database.missing-statement-timeout", "title": "No statement or query timeout", "typical_severity": "medium", "file": "DATABASE.md" },
    { "id": "database.unsafe-migration", "title": "Migration locks a large table or breaks rolling deploys", "typical_severity": "high", "file": "DATABASE.md" },

    { "id": "messaging.dual-write", "title": "Database write and message publish not atomic", "typical_severity": "critical", "file": "MESSAGING.md" },
    { "id": "messaging.ack-before-processing", "title": "Message acknowledged before work completes", "typical_severity": "high", "file": "MESSAGING.md" },
    { "id": "messaging.poison-message", "title": "Failing message retried forever with no dead-letter queue", "typical_severity": "high", "file": "MESSAGING.md" },
    { "id": "messaging.ordering-key", "title": "Ordered events published without a stable ordering key", "typical_severity": "high", "file": "MESSAGING.md" },
    { "id": "messaging.visibility-timeout", "title": "Lease expires before processing finishes", "typical_severity": "medium", "file": "MESSAGING.md" },

    { "id": "caching.stampede", "title": "Hot key expiry sends every miss to the backend", "typical_severity": "high", "file": "CACHING.md" },
    { "id": "caching.stale-write", "title": "Update order can write stale data into the cache", "typical_severity": "medium", "file": "CACHING.md" },
    { "id": "caching.missing-ttl", "title": "Cache entries with no expiry", "typical_severity": "medium", "file": "CACHING.md" },
    { "id": "caching.unbounded-local", "title": "In-process cache with no size limit", "typical_severity": "medium", "file": "CACHING.md" },
    { "id": "caching.cache-as-source-of-truth", "title": "Important data stored only in a volatile cache", "typical_severity": "high", "file": "CACHING.md" },
    { "id": "caching.penetration", "title": "Lookups for nonexistent keys always bypass the cache", "typical_severity": "medium", "file": "CACHING.md" },

    { "id": "failure.swallowed-error", "title": "Error caught and ignored", "typical_severity": "high", "file": "FAILURE-HANDLING.md" },
    { "id": "failure.partial-failure", "title": "Multi-step operation with no recovery for partial failure", "typical_severity": "critical", "file": "FAILURE-HANDLING.md" },
    { "id": "failure.unsafe-fallback", "title": "Fallback returns a plausible but wrong value", "typical_severity": "critical", "file": "FAILURE-HANDLING.md" },
    { "id": "failure.no-circuit-breaker", "title": "Non-essential dependency can take down the request path", "typical_severity": "medium", "file": "FAILURE-HANDLING.md" },
    { "id": "failure.no-graceful-shutdown", "title": "In-flight work dropped on shutdown", "typical_severity": "medium", "file": "FAILURE-HANDLING.md" },
    { "id": "failure.deep-health-check", "title": "Liveness probe depends on downstream systems", "typical_severity": "high", "file": "FAILURE-HANDLING.md" },

    { "id": "limits.unbounded-input", "title": "Request size, list length, or page size not limited", "typical_severity": "high", "file": "RESOURCE-LIMITS.md" },
    { "id": "limits.load-all-into-memory", "title": "Entire file, response, or result set loaded into memory", "typical_severity": "high", "file": "RESOURCE-LIMITS.md" },
    { "id": "limits.missing-rate-limit", "title": "Expensive or abusable endpoint without rate limiting", "typical_severity": "high", "file": "RESOURCE-LIMITS.md" },
    { "id": "limits.pool-exhaustion", "title": "Connection or thread pool can be exhausted", "typical_severity": "high", "file": "RESOURCE-LIMITS.md" },
    { "id": "limits.unbounded-queue", "title": "In-memory queue or executor with no capacity limit", "typical_severity": "medium", "file": "RESOURCE-LIMITS.md" },
    { "id": "limits.resource-leak", "title": "Connections, files, or goroutines not released on every path", "typical_severity": "high", "file": "RESOURCE-LIMITS.md" },

    { "id": "data.float-money", "title": "Money stored or computed in binary floating point", "typical_severity": "high", "file": "DATA-INTEGRITY.md" },
    { "id": "data.naive-datetime", "title": "Instants stored or compared without a time zone", "typical_severity": "high", "file": "DATA-INTEGRITY.md" },
    { "id": "data.app-only-constraints", "title": "Invariant enforced only in application code", "typical_severity": "high", "file": "DATA-INTEGRITY.md" },
    { "id": "data.id-overflow", "title": "32-bit identifiers on tables that grow without bound", "typical_severity": "high", "file": "DATA-INTEGRITY.md" },

    { "id": "observability.silent-failure", "title": "Failure path emits no log, metric, or alert", "typical_severity": "medium", "file": "OBSERVABILITY.md" },
    { "id": "observability.no-correlation-id", "title": "No request or trace ID across service boundaries", "typical_severity": "medium", "file": "OBSERVABILITY.md" },
    { "id": "observability.sensitive-data-logged", "title": "Secrets or personal data written to logs", "typical_severity": "high", "file": "OBSERVABILITY.md" },
    { "id": "observability.high-cardinality-labels", "title": "Metric labels from unbounded values", "typical_severity": "medium", "file": "OBSERVABILITY.md" },
    { "id": "observability.no-signal-on-critical-path", "title": "Critical business operation has no success/failure metric", "typical_severity": "medium", "file": "OBSERVABILITY.md" },

    { "id": "security.sql-injection", "title": "Untrusted input built into a SQL or JPQL query", "typical_severity": "critical", "file": "SECURITY-INJECTION.md" },
    { "id": "security.command-injection", "title": "Untrusted input reaches a shell or process arguments", "typical_severity": "critical", "file": "SECURITY-INJECTION.md" },
    { "id": "security.nosql-injection", "title": "Query operators injectable through unvalidated input", "typical_severity": "high", "file": "SECURITY-INJECTION.md" },
    { "id": "security.template-injection", "title": "User input compiled as a template or evaluated as an expression", "typical_severity": "critical", "file": "SECURITY-INJECTION.md" },
    { "id": "security.path-traversal", "title": "Untrusted input used to build file paths", "typical_severity": "high", "file": "SECURITY-INJECTION.md" },
    { "id": "security.unsafe-deserialization", "title": "Untrusted data passed to a type-instantiating deserializer", "typical_severity": "critical", "file": "SECURITY-INJECTION.md" },
    { "id": "security.xxe", "title": "XML parsed with DTDs or external entities enabled", "typical_severity": "high", "file": "SECURITY-INJECTION.md" },
    { "id": "security.redos", "title": "Backtracking regex with nested quantifiers on untrusted input", "typical_severity": "high", "file": "SECURITY-INJECTION.md" },

    { "id": "security.missing-authorization", "title": "Endpoint does not verify the caller's identity or permission", "typical_severity": "critical", "file": "SECURITY-ACCESS-CONTROL.md" },
    { "id": "security.idor", "title": "Object accessed by ID without an ownership check", "typical_severity": "high", "file": "SECURITY-ACCESS-CONTROL.md" },
    { "id": "security.tenant-isolation", "title": "Query, cache, or job can cross tenant boundaries", "typical_severity": "critical", "file": "SECURITY-ACCESS-CONTROL.md" },
    { "id": "security.mass-assignment", "title": "Request body bound to a model without a field allowlist", "typical_severity": "high", "file": "SECURITY-ACCESS-CONTROL.md" },
    { "id": "security.client-trusted-value", "title": "Server trusts a price, amount, role, or status sent by the client", "typical_severity": "critical", "file": "SECURITY-ACCESS-CONTROL.md" },

    { "id": "security.jwt-validation", "title": "JWT not fully verified (signature, algorithm, expiry, audience)", "typical_severity": "critical", "file": "SECURITY-AUTHENTICATION.md" },
    { "id": "security.password-storage", "title": "Passwords stored in plaintext or with a fast hash", "typical_severity": "critical", "file": "SECURITY-AUTHENTICATION.md" },
    { "id": "security.session-cookies", "title": "Session cookie flags, fixation, or invalidation missing", "typical_severity": "medium", "file": "SECURITY-AUTHENTICATION.md" },
    { "id": "security.timing-unsafe-compare", "title": "Secret compared with non-constant-time equality", "typical_severity": "medium", "file": "SECURITY-AUTHENTICATION.md" },
    { "id": "security.webhook-signature", "title": "Webhook accepted without a valid signature and replay check", "typical_severity": "critical", "file": "SECURITY-AUTHENTICATION.md" },
    { "id": "security.password-reset", "title": "Weak, reusable, or poisonable password reset tokens", "typical_severity": "high", "file": "SECURITY-AUTHENTICATION.md" },

    { "id": "security.ssrf", "title": "Server fetches user-influenced URLs without destination checks", "typical_severity": "critical", "file": "SECURITY-REQUEST-HANDLING.md" },
    { "id": "security.open-redirect", "title": "Redirect target taken from input", "typical_severity": "medium", "file": "SECURITY-REQUEST-HANDLING.md" },
    { "id": "security.cors-misconfiguration", "title": "CORS lets untrusted origins read credentialed responses", "typical_severity": "high", "file": "SECURITY-REQUEST-HANDLING.md" },
    { "id": "security.csrf", "title": "Cookie-authenticated state change without CSRF protection", "typical_severity": "high", "file": "SECURITY-REQUEST-HANDLING.md" },
    { "id": "security.xss", "title": "Untrusted data rendered into HTML without escaping", "typical_severity": "high", "file": "SECURITY-REQUEST-HANDLING.md" },
    { "id": "security.file-upload", "title": "Uploaded files trusted, served inline, or processed unsafely", "typical_severity": "high", "file": "SECURITY-REQUEST-HANDLING.md" },
    { "id": "security.verbose-errors", "title": "Stack traces or internals returned to clients", "typical_severity": "medium", "file": "SECURITY-REQUEST-HANDLING.md" },

    { "id": "security.hardcoded-secret", "title": "Credential committed to source or build files", "typical_severity": "critical", "file": "SECURITY-SECRETS-AND-CONFIG.md" },
    { "id": "security.weak-crypto", "title": "Broken algorithm, mode, or nonce handling", "typical_severity": "high", "file": "SECURITY-SECRETS-AND-CONFIG.md" },
    { "id": "security.insecure-randomness", "title": "Non-cryptographic randomness used for secrets or tokens", "typical_severity": "high", "file": "SECURITY-SECRETS-AND-CONFIG.md" },
    { "id": "security.tls-verification-disabled", "title": "Certificate or hostname verification turned off", "typical_severity": "high", "file": "SECURITY-SECRETS-AND-CONFIG.md" },
    { "id": "security.debug-in-production", "title": "Debug consoles, Actuator, or profilers exposed in production", "typical_severity": "high", "file": "SECURITY-SECRETS-AND-CONFIG.md" },
    { "id": "security.vulnerable-dependency", "title": "Dependency with a known vulnerability, reported by an audit tool", "typical_severity": "high", "file": "SECURITY-SECRETS-AND-CONFIG.md" }
  ]
}
